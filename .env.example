# Flask configuration
FLASK_SECRET_KEY=dev_secret_key_change_me_in_production_123456789
FLASK_DEBUG=True

# Database configuration (relative to app directory or absolute)
DATABASE_URL=sqlite:///blog.db

# Groq API configuration for AI assistance
# Get your API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
